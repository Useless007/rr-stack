DATABASE_URL=postgres://rr:rr@localhost:5432/rr
PORT=3000
WEB_DIST=../web/build/client
# The session cookie is Secure by default. Browsers accept that on http://localhost; set false only
# when you serve plain HTTP on another host.
COOKIE_SECURE=true
# Behind a reverse proxy (Caddy, nginx, a load balancer) set true so sign-in rate limits use the
# real client address from X-Forwarded-For. Leave false when clients reach the server directly.
TRUST_PROXY=false
