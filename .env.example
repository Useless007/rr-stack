DATABASE_URL=postgres://rr:rr@localhost:5432/rr
PORT=3000
WEB_DIST=../web/build/client
# Session cookies are Secure unless this is false. This file is for local development, where some
# browsers (Safari) refuse Secure cookies on http://localhost, so it is off here. Production and
# docker compose leave it on.
COOKIE_SECURE=false
# Behind exactly one reverse proxy that appends to X-Forwarded-For (Caddy, nginx, a load balancer)
# set true so sign-in rate limits use the real client address. Leave false when clients reach the
# server directly.
TRUST_PROXY=false
# The site's public address (https://example.com). Pages are built with it: canonical links, share
# cards, robots.txt and sitemap.xml. Set it before building for production. Unset, it is
# http://localhost:3000 (bun run build) or http://localhost:8000 (docker compose).
# SITE_URL=
